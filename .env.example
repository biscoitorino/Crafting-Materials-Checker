# Port and address for the web UI
PORT=8790
HOST=127.0.0.1

# Item name language: en, de, fr, ja
ITEM_LANG=en

# World or data centre to start on, e.g. Coeurl or Aether. Leave blank to
# start on the first data centre and pick your own in the header; whatever you
# choose there is remembered by your browser.
DEFAULT_WORLD=

# Packaged build only: minutes with nobody using the app before it shuts
# itself down. Set to 0 to keep it running until you stop it.
IDLE_EXIT_MINUTES=20
