# Port for the web UI
PORT=8790
HOST=127.0.0.1
# Item name language: en, de, fr, ja
ITEM_LANG=en
# Default world or data centre shown on first load
DEFAULT_WORLD=Coeurl
# Packaged build only: minutes with nobody using the app before it shuts
# itself down. Set to 0 to keep it running until you stop it.
IDLE_EXIT_MINUTES=20
