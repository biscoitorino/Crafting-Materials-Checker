{
  "name": "crafting-materials-checker",
  "version": "1.0.0",
  "description": "FFXIV crafting cost checker: browse recipes by class, see the recipe sheet, and price the materials on Universalis with stack-aware purchase plans.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "data": "node --env-file-if-exists=.env src/index.js --rebuild",
    "shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcuts.ps1",
    "icon": "node scripts/make-icon.mjs",
    "tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tray.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pngjs": "^7.0.0"
  }
}
